{
  "name": "backlot-engine",
  "version": "0.1.0",
  "description": "Backlot engine: prompt \u2192 script \u2192 cast \u2192 shots \u2192 rendered, edited film",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:ops": "tsx watch src/ops.ts",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "ops": "node dist/ops.js",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "e2e": "tsx test/e2e.ts",
    "e2e:vibe": "tsx test/vibe.e2e.ts",
    "e2e:runpod": "tsx test/runpod.e2e.ts",
    "e2e:reliability": "tsx test/reliability.e2e.ts",
    "e2e:scale": "tsx test/scale.e2e.ts",
    "e2e:api": "tsx test/api.e2e.ts",
    "e2e:ops": "tsx test/ops.e2e.ts",
    "preflight": "tsx src/preflight.ts",
    "eval:story": "tsx scripts/eval-story.ts",
    "local": "tsx watch --env-file=.env.local src/index.ts",
    "local:ops": "tsx watch --env-file=.env.local src/ops.ts",
    "preflight:local": "tsx --env-file=.env.local src/preflight.ts",
    "eval:story:local": "tsx --env-file=.env.local scripts/eval-story.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@hono/node-server": "^2.1.1",
    "@sentry/node": "^11.1.0",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
