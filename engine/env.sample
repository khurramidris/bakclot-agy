# Backlot engine configuration. Copy to .env for local use (never commit .env).
# Full explanations: docs/DEPLOY.md. Lines marked [required] must be set in production.

# ── Runtime ──
NODE_ENV=production                    # [required] turns credit enforcement on
PORT=8787
# LISTEN_HOST=127.0.0.1               # optional: accept connections from this computer only (the desktop app sets it)
PUBLIC_BASE_URL=https://backlot.example.com   # [required] this server's public URL
APP_URL=https://backlot.example.com           # [required] where checkout returns customers (same as above when one domain)
CORS_ORIGINS=https://backlot.example.com
FILE_SIGNING_SECRET=                   # [required] long random string: openssl rand -hex 32
RUN_WORKER=1                           # 0 on API-only replicas
WORKER_CONCURRENCY=6                   # writing jobs (long Claude turns) at once per process: mostly waiting, so raise it freely
# WORKER_LANES=llm:12,render:16,media:4   # optional: slots per lane (llm writing, render, assets pictures, media editing, io)
FAIR_LLM_PER_CUSTOMER=3                # one customer's writing jobs at once (the rest step aside so others aren't held up)
FAIR_EDITS_PER_CUSTOMER=1              # one customer's edits at once
ADMIN_USER_IDS=                        # user ids (Account page) allowed into Admin, Setup check and /v1/admin/*
SENTRY_DSN=                            # optional: error alerts by email (sentry.io → project → Client Keys)

# Database safety (the defaults are right for most setups)
DB_POOL_MAX=10                         # connections per process; replicas each open this many
DB_LOCK_TIMEOUT_MS=15000               # a transaction waiting on a lock gives up after this (the request is retried)
DB_IDLE_TX_TIMEOUT_MS=60000            # Postgres ends a transaction that goes silent this long
DB_WATCHDOG=1                          # restart the process if its database pool stops answering while the database is up

# Uploads: decoded a few at a time, so a burst can't exhaust memory
MEDIA_SLOTS=3                          # uploads decoded at once per process
MEDIA_QUEUE=24                         # more may wait; beyond that, callers are asked to retry
MAX_PARALLEL_UPLOADS=12                # large requests being received at once per process

# Company details: shown in the Terms, the Privacy Policy and support links (the Setup check flags them until set)
LEGAL_COMPANY=                         # [required] e.g. Backlot Studio Ltd
LEGAL_JURISDICTION=                    # [required] where it's registered, e.g. England and Wales
LEGAL_ADDRESS=                         # [required] registered address
SUPPORT_EMAIL=                         # [required] e.g. support@backlot.app
# LEGAL_UPDATED=14 November 2026       # the "last updated" date on the Terms and Privacy Policy

# ── Database (Supabase Postgres, session pooler) ──
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres   # [required]

# ── Sign-in (Supabase Auth) ──
SUPABASE_URL=https://xxxx.supabase.co  # [required]
SUPABASE_ANON_KEY=                     # [required] publishable/anon key (also sent to the browser)
SUPABASE_JWT_SECRET=                   # optional: verify sessions locally instead of asking Supabase

# ── File storage (S3-compatible: Supabase Storage, R2, S3) ──
STORAGE_DRIVER=s3                      # [required] in production
S3_ENDPOINT=https://xxxx.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_BUCKET=backlot
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── AI: writing, breakdown, shot planning ──
ANTHROPIC_API_KEY=                     # [required]
CLAUDE_MODEL=claude-opus-5-5                 # every writing, design, direction and shot step (docs/STORY-ENGINE.md)
CLAUDE_FAST_MODEL=claude-sonnet-5-5          # retake revisions
CLAUDE_MODELS=                         # optional per-step models, e.g. scene:claude-sonnet-5-5,judge:claude-sonnet-5-5,shots:claude-sonnet-5-5
CLAUDE_BULK_MODEL=claude-haiku-5-5     # the many small calls of a long film or series (the steps below)
CLAUDE_BULK_STEPS=outline,scene,judge,critique,breakdown,direct,shots
LONG_FORM_SECONDS=900                  # stories this long or longer are long-form: written season by season, bulk steps on CLAUDE_BULK_MODEL
SEASON_BATCH_EPISODES=12               # episodes planned per season pass
CRITIQUE_BATCH_SECONDS=600             # script notes read this much story at a time
BREAKDOWN_BATCH_SCENES=40              # scenes per cast-and-sets design call
STORY_EFFORT=high                      # thinking depth for the story, scenes, notes and direction (low|medium|high|xhigh|max)
PLANNING_EFFORT=medium                 # thinking depth for the many shot plans and judge calls
SCRIPT_DOCTOR=1                        # 0 skips the script editor's notes and the rewrites of flagged scenes
KEY_SCENE_DRAFTS=2                     # drafts of each episode's opening and ending; a judge keeps the best (1 = off)
PLAN_CONCURRENCY=4                     # scenes written or planned at once
CLAUDE_FALLBACKS=1                     # retry refused requests on Anthropic's recommended model (first-party API only)
CLAUDE_STRUCTURED_OUTPUTS=1            # 0 for a model or endpoint without structured outputs (the shape goes in the prompt)
CLAUDE_THINKING=1                      # 0 for a model or endpoint without adaptive thinking and effort
# PROMPT_LOG_DIR=./data/prompts        # write every prompt as sent, to read what the model sees

# ── Video ──
VIDEO_PROVIDER=minimax                 # [required] minimax: MiniMax's hosted H3 (launch with this) | runpod: our own GPUs,
                                       # once docs/SELF-HOSTED-H3.md is set up and a first film looks right
# Our H3 deployment on RunPod (only with VIDEO_PROVIDER=runpod)
RUNPOD_API_KEY=                        # [required with runpod]
RUNPOD_ENDPOINT_ID=                    # [required with runpod]
RUNPOD_EXECUTION_TIMEOUT_SEC=1800
RUNPOD_GPU_PRICE_PER_SECOND=0          # your GPU cost per worker-second, for margin reports
# GPU autoscaling: on by default with RunPod. The controller raises the endpoint's worker floor as soon as work is queued
# (one GPU per RUNPOD_JOBS_PER_WORKER renders that can run now) and lets it fall to zero when idle; RunPod adds GPUs
# up to the ceiling as its queue grows. As demand grows, raise RUNPOD_MAX_WORKERS (and your RunPod quota): the number
# of renders sent at once follows it. The dashboard says when demand needs more GPUs than the ceiling.
RUNPOD_MANAGE_SCALING=1                # 0 = leave the worker floor to the RunPod console
RUNPOD_WARM_WORKERS=1                  # floor while customers are active
RUNPOD_WARM_MINUTES=15                 # how long "active" lasts after the last render
RUNPOD_MAX_WORKERS=5                   # budget cap: never more GPUs than this
RUNPOD_JOBS_PER_WORKER=2               # renders per GPU (one filming, one waiting) before the floor rises
RUNPOD_CAPACITY_TICK_SECONDS=30        # how often the controller looks (every 15 s while work is waiting)
# VIDEO_MAX_INFLIGHT=                  # renders sent to the video service at once (default: RunPod max workers × jobs per
                                       # worker; with MiniMax 10: raise it if your MiniMax account allows more at once)
MAX_ACTIVE_RENDERS_PER_USER=4         # clips filming at once per customer, across all their videos (any length)
RENDERS_PER_PROJECT=                   # clips of one film at once, in story order (empty = MAX_ACTIVE_RENDERS_PER_USER)
CHAIN_CLIPS=0                          # 1 sends each scene's previous clip as a reference video (billed as input seconds,
                                       # and about 2× the GPU work on RunPod)

# ── Quick clips (text, image, characters & products, remix) ──
CLIP_MIN_SECONDS=5                     # shortest clip customers can pick (the longest is 15)
# CLIP_IMAGE_PROVIDER=minimax          # send image-to-video clips to MiniMax's hosted H3 (default: the same as VIDEO_PROVIDER)
MODERATION=1                           # content check (Claude, fast model) on clip prompts, uploads and hand-edited shot prompts

# ── Reference images and voices (hosted APIs) ──
MINIMAX_API_KEY=                       # [required] image-01 references, voice design, and video with VIDEO_PROVIDER=minimax
IMAGE_PROVIDER=minimax                 # minimax | gemini | openai
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Customer pricing (USD credits) ──
SELL_PER_SECOND_768P=0.16
SELL_PER_SECOND_2K=0.26
SETUP_FEE_USD=2                        # a new video's first automatic pass: story, screenplay, cast, sets, shot plan (an estimate of our AI cost plus margin: check Admin after real runs)
SELL_IMAGE_USD=0.05                    # each new image of a character, outfit, set or prop
SELL_VOICE_USD=0.05                    # each new character voice
SELL_BREAKDOWN_USD=0.5                 # redesigning cast and sets from the script (studio projects, re-runs)
SELL_PLAN_USD=0.75                     # re-planning an episode's shots (studio projects, re-plans)
SELL_REVISION_USD=0.05                 # rewriting a shot from a review note
SELL_PITCH_USD=0.25                    # three new takes on the story idea (step by step)
SELL_SCENE_USD=0.1                     # rewriting one scene of the script from a note
SETUP_FEE_INCLUDED_MINUTES=10          # story length covered by SETUP_FEE_USD
SETUP_FEE_PER_MINUTE_USD=0.1           # added per minute beyond that (a 90-minute film: 2 + 80 × 0.1 = $10)
BREAKDOWN_INCLUDED_SCENES=20           # scenes SELL_BREAKDOWN_USD covers; each one more adds SELL_BREAKDOWN_SCENE_USD
SELL_BREAKDOWN_SCENE_USD=0.02
PLAN_INCLUDED_SCENES=12                # scenes SELL_PLAN_USD covers; each one more adds SELL_PLAN_SCENE_USD
SELL_PLAN_SCENE_USD=0.08
SIGNUP_CREDIT_USD=0
MAX_RUNTIME_SECONDS=0                  # longest story a customer can order (0 = no limit). Until a long film has been made
                                       # for real and its cost checked on Admin, you may want a cap such as 1800
FREE_INPUT_IMAGES=5                    # MiniMax: reference pictures per video request that are free…
PRICE_INPUT_IMAGE=0.04                 # …and what each one past that costs us (for the cost reports)

# Screenplays: limits per request, so the AI work behind one request stays bounded
MAX_SCRIPT_CHARS=40000                 # one episode's script
MAX_EPISODE_SCENES=80                  # scenes in one episode
MAX_IMPORT_EPISODES=120                # episodes in one imported project
IMPORT_ENABLED=0                       # importing a ready-made screenplay (POST /v1/projects): the web app doesn't offer it

# ── Basic plan (required to create) ──
PLAN_NAME=Basic
PLAN_PRICE_USD=20                      # shown to customers; the charge itself is set on the Lemon Squeezy product
PLAN_CREDITS_USD=20                    # plan credit each month, reset (not added) at every renewal
PLAN_STORAGE_GB=10                     # storage per customer, kept until they delete it (10 GB on R2 is about $0.15/month)

# ── Company dashboard (/admin): what profit means ──
FIXED_COSTS_MONTHLY=                   # monthly bills, name:usd, e.g. Railway:20,Supabase:25,RunPod storage:5.25
PAYMENT_FEE_PCT=5                      # Lemon Squeezy's cut, for estimated fees: 5% + $0.50 a payment
PAYMENT_FEE_USD=0.5

# ── Lemon Squeezy (Merchant of Record: handles VAT and sales tax) ──
LEMONSQUEEZY_API_KEY=                  # [required to take payments] Settings → API
LEMONSQUEEZY_STORE_ID=                 # [required to take payments] Settings → Stores (the number)
LEMONSQUEEZY_WEBHOOK_SECRET=           # [required to take payments] the signing secret of the webhook
LEMONSQUEEZY_BASIC_VARIANT_ID=         # [required to take payments] variant id of the $20/month Basic product
# Top-up packs for anyone (they also pay for the API), never expire: id:credit_usd:variant_id. The credit comes from here,
# never from the amount paid.
# e.g. starter:10:123456,creator:50:123457,studio:200:123458 (the Setup check lists your variant ids). Empty = packs shown
# as unavailable until you fill this in.
CREDIT_PACKS=

# ── Public API (/api/v1): pay-as-you-go keys for clips and microdramas ──
API_ENABLED=0                          # 1 opens the API (do it once a real film and clips are made and costs are checked)
API_RETENTION_DAYS=7                   # API videos and films are deleted this long after they finish…
API_FAILED_RETENTION_DAYS=1            # …and this long after a failure
API_REQUESTS_PER_MINUTE=300            # per key
API_CREATES_PER_MINUTE=30              # new videos and films per account
API_MAX_ACTIVE_PER_ACCOUNT=20          # videos being made at once per account
API_MAX_ACTIVE_FILMS=3                 # films being made at once per account
API_FILM_MAX_SECONDS=900               # the longest film one API request may ask for
API_REFUSALS_BEFORE_SUSPEND=5          # content refusals in 24 h before an account's API access is suspended
API_WEBHOOK_TIMEOUT_SEC=10
API_MAX_KEYS=10                        # active keys per account
API_LOG_DAYS=30                        # how long the API request log is kept

# ── Local development only (never in production) ──
# API_ALLOW_PRIVATE_URLS=1             # let API media and webhook URLs point at this machine (tests); refused in production
# MOCK_PROVIDERS=1                     # fake Claude, images, voices and MiniMax video
# ALLOW_DEV_TOKENS=1                   # sign in as a fixed dev user without Supabase

# Optional: ship the font with the app instead of relying on one installed on the machine (the desktop app does this).
# SUBTITLE_FONT_FILE=/path/to/DejaVuSans-Bold.ttf   # for text drawn into placeholder pictures and slates
# SUBTITLE_FONTS_DIR=/path/to/fonts                 # folder libass searches for the subtitle font; also switches that text to
#                                                   # libass for FFmpeg builds without the drawtext filter
