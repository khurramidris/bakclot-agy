# Backlot on your own computer with the REAL services. Copy this file to .env.local (git ignores it) and fill it in:
#   cp env.local.sample .env.local
# Then run:  npm run local        (from the engine folder)         Full guide: docs/LOCAL.md

# ── Your computer ──
DATABASE_URL=postgres://postgres@localhost:5432/backlot   # an empty Postgres database
PORT=8787
ALLOW_DEV_TOKENS=1                     # signs you in as a fixed dev user: no Supabase, nothing charged
STORAGE_DIR=./data/files               # where images, clips and films are saved on this computer

# ── Where RunPod reaches this computer ──
# RunPod's GPU downloads the reference images from here and uploads each finished clip back to it, so it needs a public
# https address. Start a tunnel (free, no account):  cloudflared tunnel --url http://localhost:8787
# and paste the https://….trycloudflare.com address it prints. It changes each time you start the tunnel.
PUBLIC_BASE_URL=

# ── Writing, casting and shot planning (Anthropic) ──
ANTHROPIC_API_KEY=
STORY_EFFORT=high                      # medium is cheaper and a bit less polished
SCRIPT_DOCTOR=1                        # 0 skips the script editor's notes and rewrites (faster, a little less polished)
# CLAUDE_MODELS=scene:claude-sonnet-5-5,judge:claude-sonnet-5-5,shots:claude-sonnet-5-5   # cheaper model for the many small calls
# PROMPT_LOG_DIR=./data/prompts        # save every prompt as sent, to read exactly what the model sees

# ── Character, set and prop images, and voices (MiniMax) ──
MINIMAX_API_KEY=
IMAGE_PROVIDER=minimax                 # or gemini / openai (then set GEMINI_API_KEY / OPENAI_API_KEY). Voices always use MiniMax.

# ── Video: your H3 on RunPod ──
VIDEO_PROVIDER=runpod
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_GPU_PRICE_PER_SECOND=0.00031    # your GPU cost per worker-second (RTX 4090 serverless): shows real cost per film in Admin
# CLIP_IMAGE_PROVIDER=minimax          # send image-to-video quick clips to MiniMax's hosted H3 if yours look wrong
# CHAIN_CLIPS=1                        # send each scene's previous shot along for continuity (about 2× the GPU work)

# ── Keep a first test small ──
MAX_RUNTIME_SECONDS=120                # hard cap per project: one 75-second episode is plenty for a first look
RUNPOD_MAX_WORKERS=1                   # GPUs at most: Backlot sets the endpoint's Max workers to this (and its Active workers
                                       # by demand, back to 0 when idle)
VIDEO_MAX_INFLIGHT=1                   # renders in flight at once (raise both when it works)

# Subtitles use this font. On Mac or Windows, DejaVu Sans may not be installed: name one you have.
# SUBTITLE_FONT=Arial
